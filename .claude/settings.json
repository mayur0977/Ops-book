{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(docker compose ps:*)",
      "Bash(git branch:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git status:*)",
      "Bash(pnpm check:client-safe)",
      "Bash(pnpm check:invariants)",
      "Bash(pnpm check:vertical-leak)",
      "Bash(pnpm format:check)",
      "Bash(pnpm lint)",
      "Bash(pnpm test)",
      "Bash(pnpm test:affected)",
      "Bash(pnpm turbo run:*)",
      "Bash(pnpm typecheck)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.production)",
      "Read(./.env.staging)",
      "Read(./**/*.p8)",
      "Read(./**/*.keystore)",
      "Read(./**/*.pem)"
    ]
  }
}
