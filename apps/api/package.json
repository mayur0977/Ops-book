{
  "name": "@daybook/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "lint": "oxlint -c ../../packages/config/oxlintrc.base.json src test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:tenant": "vitest run test/tenant-isolation.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "db:bootstrap": "tsx src/db/bootstrap-local.ts",
    "start": "node --experimental-strip-types src/index.ts"
  },
  "dependencies": {
    "@daybook/contracts": "workspace:*",
    "@daybook/core": "workspace:*",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/swagger": "9.8.1",
    "@node-rs/argon2": "2.2.0",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.1",
    "fastify-plugin": "6.0.0",
    "fastify-type-provider-zod": "7.0.0",
    "jose": "6.2.10",
    "openapi-types": "12.1.3",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@daybook/config": "workspace:*",
    "@types/node": "26.4.0",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.10",
    "oxlint": "1.80.0",
    "pino-pretty": "13.1.3",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
