{
  "name": "@daybook/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "lint": "oxlint -c ../../packages/config/oxlintrc.base.json src test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:tenant": "vitest run test/tenant-isolation.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "db:bootstrap": "tsx src/db/bootstrap-local.ts"
  },
  "dependencies": {
    "@daybook/contracts": "workspace:*",
    "@daybook/core": "workspace:*",
    "drizzle-orm": "0.45.2",
    "pg": "8.23.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@daybook/config": "workspace:*",
    "@types/node": "26.4.0",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.10",
    "oxlint": "1.80.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
