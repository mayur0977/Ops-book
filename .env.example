# Copy to .env and fill in. NEVER commit .env.
# Anything prefixed EXPO_PUBLIC_ is bundled into the mobile app and is PUBLIC.

# ---- API ----
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# ---- Database ----
DATABASE_URL=postgresql://opsbook:local_dev_only@localhost:5432/opsbook_dev

# ---- Redis (BullMQ) ----
REDIS_URL=redis://localhost:6379

# ---- Auth ----
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# ---- Object storage (MinIO locally, S3/R2 in production) ----
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_BUCKET=opsbook-media-dev
S3_ACCESS_KEY_ID=opsbook
S3_SECRET_ACCESS_KEY=local_dev_only
S3_FORCE_PATH_STYLE=true
SIGNED_URL_TTL_SECONDS=300

# ---- SMS provider ----
# "console" prints the OTP to the log so auth can be built before
# DLT registration completes. Never "console" outside development.
SMS_PROVIDER=console
SMS_API_KEY=
SMS_SENDER_ID=
SMS_TEMPLATE_ID_OTP=

# ---- Push ----
EXPO_ACCESS_TOKEN=

# ---- Observability ----
SENTRY_DSN=

# ---- Mobile (public — safe to bundle) ----
EXPO_PUBLIC_API_URL=http://localhost:3000
