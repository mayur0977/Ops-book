{
  "name": "daybook",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.20.0",
    "pnpm": ">=11"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:affected": "turbo run test --filter=...[origin/main]",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "check:vertical-leak": "bash scripts/check-vertical-leak.sh",
    "format": "prettier --write \"{apps,packages,scripts}/**/*.{ts,tsx,js,mjs,json}\"",
    "format:check": "prettier --check \"{apps,packages,scripts}/**/*.{ts,tsx,js,mjs,json}\"",
    "check:client-safe": "node scripts/check-client-safe.mjs",
    "check:invariants": "pnpm check:vertical-leak && pnpm check:client-safe"
  },
  "devDependencies": {
    "@daybook/config": "workspace:*",
    "prettier": "3.9.6",
    "turbo": "2.10.12",
    "typescript": "7.0.2"
  }
}
